# Required for Gateway — board chat (task ledger + bot registration calibrate)
CALIBRATION_CHAT_ID=oc_your_board_chat_id

# Required when WORKER_IMPL=dispatcher (default)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional LLM overrides
# DISPATCHER_LLM_PROVIDER=deepseek
# DISPATCHER_LLM_MODEL=deepseek-v4-pro
# DISPATCHER_LLM_BASE_URL=https://api.deepseek.com
# DISPATCHER_LLM_API_KEY=
# DISPATCHER_AGENT_MAX_ITERATIONS=6

# Optional Gateway / worker
# HOST=0.0.0.0
# PORT=8000
# GATEWAY_BASE_URL=http://127.0.0.1:8000
# GATEWAY_TOKEN=
# GATEWAY_DB_PATH=
# GATEWAY_TASK_WORKSPACE=
# WORKER_ID=daemon-1
# WORKER_IDLE_SLEEP=1
# WORKER_IMPL=dispatcher
# AGENT_WORKER_ID=agent-1
# AGENT_RUN_HTTP_TIMEOUT=3600

# Agent / ledger (Researcher–Executor MVP)
# AGENT_REQUIRE_PLAN_BEFORE_EXEC=true
# LEDGER_COMMAND_BOT_ID=

# Optional lark-cli
# LARK_USER_PROFILE=
# DEFAULT_BOT_ID=
